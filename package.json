{
	"name": "liminal-installer",
	"private": true,
	"version": "0.1.0",
	"license": "Apache-2.0 OR MIT",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --cwd apps/studio dev",
		"build": "bun run --cwd apps/studio build",
		"typecheck": "bun run --cwd apps/studio typecheck",
		"test:js": "bun run --cwd apps/studio test",
		"tauri": "bun run --cwd apps/studio tauri",
		"tauri:dev": "bun run --cwd apps/studio tauri:dev",
		"check:headers": "bash scripts/check-headers.sh",
		"format": "prettier --write --no-error-on-unmatched-pattern \"apps/studio/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\"",
		"format:check": "prettier --check --no-error-on-unmatched-pattern \"apps/studio/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\"",
		"bindings": "bash scripts/generate-protocol-bindings.sh",
		"check:bindings": "bash scripts/check-bindings-drift.sh"
	},
	"devDependencies": {
		"prettier": "^3.10.1"
	}
}
