{
	"name": "@liminal-hq/installer-renderer",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "Apache-2.0 OR MIT",
	"description": "The React renderer that draws an installer's layout trees: the Afterglow, Fizz classic, InstallShield-style and Windows 11 looks, the node renderers, the theme stage and the status meters. Shared by the Studio's previews and the web runner. Source only.",
	"files": [
		"src",
		"scripts"
	],
	"exports": {
		".": "./src/index.ts",
		"./scripts/jsx-literals": "./scripts/jsx-literals.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"check:i18n": "bun scripts/check-i18n.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@liminal-hq/installer-protocol": "workspace:*"
	},
	"peerDependencies": {
		"react": "^19.1.0"
	},
	"devDependencies": {
		"@types/node": "^22",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"happy-dom": "^21.0.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^5.6",
		"vite": "^6",
		"vitest": "^3"
	}
}
