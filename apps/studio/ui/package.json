{
	"name": "liminal-installer-studio-ui",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0 OR MIT",
	"scripts": {
		"tokens": "node scripts/tokens-to-css.mjs",
		"dev": "bun run tokens && vite",
		"build": "bun run tokens && tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"tauri": "tauri",
		"tauri:dev": "cd .. && tauri dev --config src-tauri/tauri.conf.dev.json",
		"tauri:build": "cd .. && tauri build"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.4",
		"@codemirror/commands": "6.11.1",
		"@codemirror/language": "6.13.1",
		"@codemirror/legacy-modes": "6.5.5",
		"@codemirror/lint": "6.9.7",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@fontsource/vt323": "^5.3.0",
		"@lezer/highlight": "1.2.5",
		"@liminal-hq/plugin-system-appearance": "^0.1.0",
		"@liminal-hq/studio-chrome": "link:./vendor/studio-chrome",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.6",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"happy-dom": "^21.0.4",
		"typescript": "^5.6",
		"vite": "^6",
		"vitest": "^3"
	}
}
