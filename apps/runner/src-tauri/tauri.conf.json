{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Liminal Installer Runner",
	"mainBinaryName": "liminal-runner",
	"version": "0.1.0",
	"identifier": "ca.liminalhq.installerrunner",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1421",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Liminal Installer",
				"width": 1024,
				"height": 720,
				"minWidth": 640,
				"minHeight": 420,
				"center": true,
				"visible": false,
				"decorations": true
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"publisher": "Liminal HQ",
		"icon": ["icons/icon.png"]
	}
}
