{
	"name": "liminal-installer-runner",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0 OR MIT",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit",
		"check:i18n": "bun scripts/check-i18n.ts",
		"test": "vitest run",
		"test:ci": "mkdir -p ../../test-results && vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/runner-junit.xml",
		"tauri": "tauri",
		"tauri:dev": "tauri dev --config src-tauri/tauri.conf.dev.json",
		"tauri:build": "tauri build"
	},
	"dependencies": {
		"@liminal-hq/installer-protocol": "workspace:*",
		"@liminal-hq/installer-renderer": "workspace:*",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zustand": "^5"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.6",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^4.7.0",
		"happy-dom": "^21.0.4",
		"typescript": "^5.6",
		"vite": "^6",
		"vitest": "^3"
	}
}
