{
	"$schema": "https://liminal-hq.github.io/installer/schema/flow.json",
	"version": 1,
	"id": "modify",
	"steps": [
		{
			"id": "components",
			"type": "page",
			"layout": "components",
			"next": "ready"
		},
		{
			"id": "ready",
			"type": "page",
			"layout": "ready",
			"on_enter": "builtin:check-disk-space",
			"next": "copying"
		},
		{
			"id": "copying",
			"type": "commit",
			"layout": "copying",
			"next": "done"
		},
		{
			"id": "done",
			"type": "finish",
			"layout": "done"
		}
	]
}
