{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "done",
	"root": {
		"kind": "window",
		"props": {
			"title": "Lieutenant Fizz — Episode One",
			"label": "Setup Complete"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Setup Complete",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Setup has finished installing {product.name} on your computer.",
							"role": "body"
						}
					},
					{
						"kind": "checklist",
						"bind": "finish.launch",
						"props": {
							"label": "After setup",
							"items": [
								{
									"id": "launch",
									"label": "Launch Lieutenant Fizz"
								}
							]
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Finish",
							"action": "finish",
							"default": true,
							"hotkey": "F"
						}
					}
				]
			}
		]
	}
}
