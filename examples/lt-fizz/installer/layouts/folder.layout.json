{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "folder",
	"root": {
		"kind": "window",
		"props": {
			"title": "Lieutenant Fizz — Episode One",
			"label": "Choose Destination Location"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Choose Destination Location",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Setup will install Lieutenant Fizz in the following folder.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "To install to this folder, click Next. To install to a different folder, click Browse and choose another folder.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "You can choose not to install Lieutenant Fizz by clicking Cancel to exit Setup.",
							"role": "body"
						}
					},
					{
						"kind": "path",
						"bind": "install.path",
						"props": {
							"label": "Destination Folder",
							"mode": "directory",
							"browse": "Browse…",
							"hotkey": "r"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Back",
							"action": "back",
							"hotkey": "B"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true,
							"hotkey": "N"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
