{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "components",
	"root": {
		"kind": "window",
		"props": {
			"title": "Lieutenant Fizz — Episode One",
			"label": "Select Components"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Select Components",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Select the components you want to install, and clear the components you do not want to install.",
							"role": "body"
						}
					},
					{
						"kind": "checklist",
						"bind": "components.selected",
						"props": {
							"label": "Components",
							"items": "components",
							"sunken": true
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Space required: {install.size} · Free: {system.free_space}",
							"role": "caption"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Back",
							"action": "back",
							"hotkey": "B"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true,
							"hotkey": "N"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
