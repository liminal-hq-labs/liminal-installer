{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "intro",
	"root": {
		"kind": "backdrop",
		"props": {
			"style": "classic",
			"title": "Lieutenant Fizz — Episode One",
			"label": "Lieutenant Fizz — Episode One setup"
		},
		"children": [
			{
				"kind": "dialog",
				"props": {
					"title": "Intro — Lt. Fizz",
					"label": "Intro",
					"style": "win32-classic"
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 12
						},
						"children": [
							{
								"kind": "image",
								"props": {
									"label": "Lieutenant Fizz title art",
									"source": "title",
									"alt": "Lieutenant Fizz grins beside a rocket"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Lieutenant Fizz — Episode One",
									"role": "heading"
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 8,
							"align": "end"
						},
						"children": [
							{
								"kind": "button",
								"props": {
									"label": "Start",
									"action": "next",
									"default": true
								}
							}
						]
					}
				]
			}
		],
		"overrides": {
			"tui-retro": {
				"kind": "backdrop",
				"props": {
					"style": "text-mode",
					"charset": "cp437",
					"fill": "░",
					"title": "Lieutenant Fizz — Episode One",
					"label": "Lieutenant Fizz — Episode One setup",
					"palette": "blue-on-grey"
				},
				"children": [
					{
						"kind": "dialog",
						"props": {
							"title": "Intro",
							"label": "Intro",
							"border": "double",
							"shadow": true
						},
						"children": [
							{
								"kind": "stack",
								"props": {
									"direction": "column",
									"gap": 1
								},
								"children": [
									{
										"kind": "image",
										"props": {
											"label": "Lieutenant Fizz title art",
											"source": "title",
											"alt": "Lieutenant Fizz grins beside a rocket"
										}
									},
									{
										"kind": "text",
										"props": {
											"text": "Lieutenant Fizz — Episode One",
											"role": "heading"
										}
									}
								]
							},
							{
								"kind": "stack",
								"props": {
									"direction": "row",
									"gap": 8,
									"align": "end"
								},
								"children": [
									{
										"kind": "button",
										"props": {
											"label": "Start",
											"action": "next",
											"default": true
										}
									}
								]
							}
						]
					}
				]
			},
			"tui": {
				"kind": "window",
				"props": {
					"title": "Lieutenant Fizz — Episode One — Intro",
					"label": "Intro",
					"border": "rounded"
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 1
						},
						"children": [
							{
								"kind": "image",
								"props": {
									"label": "Lieutenant Fizz title art",
									"source": "title",
									"alt": "Lieutenant Fizz grins beside a rocket"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Lieutenant Fizz — Episode One",
									"role": "heading"
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 8,
							"align": "end"
						},
						"children": [
							{
								"kind": "button",
								"props": {
									"label": "Start",
									"action": "next",
									"default": true
								}
							}
						]
					}
				]
			}
		}
	}
}
