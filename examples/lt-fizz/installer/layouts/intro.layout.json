{
  "$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
  "version": 1,
  "id": "intro",
  "root": {
    "kind": "backdrop",
    "props": {
      "title": "Lieutenant Fizz — Episode One",
      "label": "Lieutenant Fizz — Episode One setup"
    },
    "children": [
      {
        "kind": "dialog",
        "props": {
          "title": "Intro — Lt. Fizz",
          "label": "Intro",
          "style": "win32-classic"
        },
        "children": [
          {
            "kind": "stack",
            "props": {
              "direction": "column",
              "gap": 12
            },
            "children": [
              {
                "kind": "image",
                "props": {
                  "label": "Lieutenant Fizz title art",
                  "source": "title",
                  "alt": "Lieutenant Fizz grins beside a rocket"
                }
              },
              {
                "kind": "text",
                "props": {
                  "text": "Lieutenant Fizz — Episode One",
                  "role": "heading"
                }
              }
            ]
          },
          {
            "kind": "stack",
            "props": {
              "direction": "row",
              "gap": 8,
              "align": "end"
            },
            "children": [
              {
                "kind": "button",
                "props": {
                  "label": "Start",
                  "action": "next",
                  "default": true
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
