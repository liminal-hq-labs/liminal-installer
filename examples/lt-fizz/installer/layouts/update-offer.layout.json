{
  "$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
  "version": 1,
  "id": "update-offer",
  "root": {
    "kind": "backdrop",
    "props": {
      "title": "Lieutenant Fizz — Episode One",
      "label": "Lieutenant Fizz — Episode One setup"
    },
    "children": [
      {
        "kind": "dialog",
        "props": {
          "title": "Update available — Lt. Fizz",
          "label": "Update available",
          "style": "win32-classic"
        },
        "children": [
          {
            "kind": "stack",
            "props": {
              "direction": "column",
              "gap": 12
            },
            "children": [
              {
                "kind": "text",
                "props": {
                  "text": "An update is available",
                  "role": "heading"
                }
              },
              {
                "kind": "text",
                "props": {
                  "text": "Version {feed.latest} is ready. You have {receipt.installed}.",
                  "role": "body"
                }
              },
              {
                "kind": "text",
                "props": {
                  "role": "document",
                  "text": "{feed.notes}",
                  "label": "Release notes",
                  "scroll": true
                }
              }
            ]
          },
          {
            "kind": "stack",
            "props": {
              "direction": "row",
              "gap": 8,
              "align": "end"
            },
            "children": [
              {
                "kind": "button",
                "props": {
                  "label": "Update now",
                  "action": "next",
                  "default": true
                }
              },
              {
                "kind": "button",
                "props": {
                  "label": "Not now",
                  "action": "skip"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
