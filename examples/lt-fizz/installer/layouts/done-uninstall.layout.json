{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "done-uninstall",
	"root": {
		"kind": "window",
		"props": {
			"title": "Lieutenant Fizz — Episode One",
			"label": "Setup Complete"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Setup Complete",
							"role": "heading"
						},
						"children": []
					},
					{
						"kind": "text",
						"props": {
							"text": "{product.name} has been removed from your computer.",
							"role": "body"
						},
						"children": []
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Finish",
							"action": "finish",
							"default": true,
							"hotkey": "F"
						},
						"children": []
					}
				]
			}
		]
	}
}
