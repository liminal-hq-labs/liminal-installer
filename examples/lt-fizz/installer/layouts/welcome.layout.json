{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "welcome",
	"root": {
		"kind": "window",
		"props": {
			"title": "Lieutenant Fizz — Episode One",
			"label": "Welcome"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Welcome",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Welcome to the {product.name} Setup program. This program will install the game on your computer.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "It is strongly recommended that you exit all other programs before running this Setup program.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Click Cancel to quit Setup and close any programs you have running. Click Next to continue with the Setup program.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Version {product.version} · {target.id}",
							"role": "caption"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true,
							"hotkey": "N"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
