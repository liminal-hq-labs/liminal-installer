{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "licence",
	"root": {
		"kind": "window",
		"props": {
			"title": "Lieutenant Fizz — Episode One",
			"label": "Software License Agreement"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Software License Agreement",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Please read the following license agreement. Press the PAGE DOWN key to see the rest of the agreement.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "",
							"role": "document",
							"source": "LICENCE.TXT",
							"scroll": true,
							"label": "Licence text"
						}
					},
					{
						"kind": "radio",
						"bind": "licence.accepted",
						"props": {
							"label": "Licence acceptance",
							"options": [
								{
									"id": "yes",
									"label": "I accept the agreement"
								},
								{
									"id": "no",
									"label": "I do not accept the agreement"
								}
							]
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Back",
							"action": "back",
							"hotkey": "B"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true,
							"hotkey": "N",
							"enabled_when": "state.licence.accepted == 'yes'"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
