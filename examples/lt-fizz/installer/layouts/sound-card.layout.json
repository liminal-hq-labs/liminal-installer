{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "sound-card",
	"root": {
		"kind": "window",
		"props": {
			"title": "Lieutenant Fizz — Episode One",
			"label": "Sound Card"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Sound Card",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Setup found: {sound.detected}.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Choose how Lt. Fizz should play sound.",
							"role": "body"
						}
					},
					{
						"kind": "radio",
						"bind": "sound.card",
						"props": {
							"label": "Sound card",
							"options": [
								{
									"id": "none",
									"label": "No sound"
								},
								{
									"id": "speaker",
									"label": "PC speaker"
								},
								{
									"id": "adlib",
									"label": "AdLib music card"
								},
								{
									"id": "sbpro",
									"label": "Sound Blaster / Pro / 16"
								},
								{
									"id": "gus",
									"label": "Gravis UltraSound"
								}
							],
							"sunken": true
						}
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 3,
							"group": "fields"
						},
						"children": [
							{
								"kind": "field",
								"bind": "sound.port",
								"props": {
									"label": "Port",
									"default": "220",
									"width": 4
								}
							},
							{
								"kind": "field",
								"bind": "sound.irq",
								"props": {
									"label": "IRQ",
									"default": "5",
									"width": 2
								}
							},
							{
								"kind": "field",
								"bind": "sound.dma",
								"props": {
									"label": "DMA",
									"default": "1",
									"width": 2
								}
							}
						]
					},
					{
						"kind": "text",
						"props": {
							"text": "{validate.problems}",
							"role": "error",
							"label": "Problems"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Back",
							"action": "back",
							"hotkey": "B"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true,
							"hotkey": "N"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
