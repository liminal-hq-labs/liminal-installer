{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "ready",
	"root": {
		"kind": "window",
		"props": {
			"title": "Lieutenant Fizz — Episode One",
			"label": "Start Copying Files"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Start Copying Files",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Setup has enough information to start copying the program files. If you want to review or change any settings, click Back. If you are satisfied with the settings, click Next to begin copying files.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "{plan.summary}",
							"role": "summary",
							"label": "Installation summary"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Destination: {install.path}",
							"role": "caption"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Back",
							"action": "back",
							"hotkey": "B"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "commit",
							"default": true,
							"hotkey": "N"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
