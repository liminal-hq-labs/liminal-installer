{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "sound-card",
	"root": {
		"kind": "dialog",
		"props": {
			"title": "Sound Card",
			"label": "Sound Card",
			"border": "double",
			"shadow": true,
			"width": 56
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Setup found: {sound.detected}.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Choose how Lt. Fizz should play sound.",
							"role": "body"
						}
					},
					{
						"kind": "radio",
						"bind": "sound.card",
						"props": {
							"label": "Sound card",
							"options": [
								{
									"id": "none",
									"label": "No sound"
								},
								{
									"id": "speaker",
									"label": "PC speaker"
								},
								{
									"id": "adlib",
									"label": "AdLib music card"
								},
								{
									"id": "sbpro",
									"label": "Sound Blaster / Pro / 16"
								},
								{
									"id": "gus",
									"label": "Gravis UltraSound"
								}
							],
							"sunken": true
						}
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 3,
							"group": "fields"
						},
						"children": [
							{
								"kind": "field",
								"bind": "sound.port",
								"props": {
									"label": "Port",
									"default": "220",
									"width": 4
								}
							},
							{
								"kind": "field",
								"bind": "sound.irq",
								"props": {
									"label": "IRQ",
									"default": "5",
									"width": 2
								}
							},
							{
								"kind": "field",
								"bind": "sound.dma",
								"props": {
									"label": "DMA",
									"default": "1",
									"width": 2
								}
							}
						]
					},
					{
						"kind": "text",
						"props": {
							"text": "{validate.problems}",
							"role": "error",
							"label": "Problems"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "centre",
					"region": "footer"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Test",
							"action": "test",
							"hotkey": "T"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "OK",
							"action": "next",
							"default": true,
							"hotkey": "O"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Back",
							"action": "back",
							"hotkey": "B"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1,
					"region": "side"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Lt. Fizz",
							"role": "title"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Episode One",
							"role": "subtitle"
						}
					},
					{
						"kind": "image",
						"props": {
							"label": "Lt. Fizz",
							"alt": "Lt. Fizz",
							"art": {
								"width": 6,
								"height": 10,
								"scale": 12,
								"rects": [
									[
										1,
										0,
										4,
										1,
										"#aaaaaa"
									],
									[
										0,
										1,
										6,
										8,
										"#aa0000"
									],
									[
										0,
										4,
										6,
										2,
										"#ffffff"
									],
									[
										2,
										4,
										2,
										2,
										"#0000aa"
									],
									[
										1,
										9,
										4,
										1,
										"#aaaaaa"
									],
									[
										4,
										2,
										1,
										1,
										"#ff5555"
									]
								]
							}
						}
					},
					{
						"kind": "progress",
						"props": {
							"label": "Setup steps",
							"role": "steps",
							"value": 5,
							"max": 8,
							"text": "Step 5 of 8"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 3,
					"region": "hints"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Select",
							"key": "↑↓"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Accept",
							"key": "Enter"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Play a test sound",
							"key": "T"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Help",
							"key": "F1"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Back",
							"key": "Esc"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Quit setup",
							"key": "F3"
						}
					}
				]
			}
		]
	}
}
