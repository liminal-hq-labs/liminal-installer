{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "folder",
	"root": {
		"kind": "backdrop",
		"props": {
			"style": "text-mode",
			"charset": "cp437",
			"fill": "░",
			"title": "{product.name}  Setup",
			"credit": "Liminal Installer",
			"label": "Lieutenant Fizz — Episode One setup"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1,
					"region": "side"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Lt. Fizz",
							"role": "title"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Episode One",
							"role": "subtitle"
						}
					},
					{
						"kind": "image",
						"props": {
							"label": "Lt. Fizz",
							"alt": "Lt. Fizz",
							"art": {
								"width": 6,
								"height": 10,
								"scale": 12,
								"rects": [
									[
										1,
										0,
										4,
										1,
										"#aaaaaa"
									],
									[
										0,
										1,
										6,
										8,
										"#aa0000"
									],
									[
										0,
										4,
										6,
										2,
										"#ffffff"
									],
									[
										2,
										4,
										2,
										2,
										"#0000aa"
									],
									[
										1,
										9,
										4,
										1,
										"#aaaaaa"
									],
									[
										4,
										2,
										1,
										1,
										"#ff5555"
									]
								]
							}
						}
					},
					{
						"kind": "progress",
						"props": {
							"label": "Setup steps",
							"role": "steps",
							"value": 3,
							"max": 8,
							"text": "Step 3 of 8"
						}
					}
				]
			},
			{
				"kind": "dialog",
				"props": {
					"title": "Destination",
					"label": "Destination",
					"border": "double",
					"shadow": true,
					"width": 56
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 1
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Setup will install Lt. Fizz in this folder.",
									"role": "body"
								}
							},
							{
								"kind": "path",
								"bind": "install.path",
								"props": {
									"label": "Folder",
									"mode": "directory",
									"width": 28
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Space required: {install.size} · Free: {system.free_space}",
									"role": "caption"
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 2,
							"align": "centre",
							"region": "footer"
						},
						"children": [
							{
								"kind": "button",
								"props": {
									"label": "Back",
									"action": "back",
									"hotkey": "B"
								}
							},
							{
								"kind": "button",
								"props": {
									"label": "Next",
									"action": "next",
									"default": true,
									"hotkey": "N"
								}
							},
							{
								"kind": "button",
								"props": {
									"label": "Cancel",
									"action": "cancel"
								}
							}
						]
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 3,
					"region": "hints"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Next field",
							"key": "Tab"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Accept",
							"key": "Enter"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Back",
							"key": "Esc"
						}
					}
				]
			}
		]
	}
}
