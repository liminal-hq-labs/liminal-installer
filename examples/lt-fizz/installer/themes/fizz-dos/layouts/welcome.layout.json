{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "welcome",
	"root": {
		"kind": "backdrop",
		"props": {
			"style": "text-mode",
			"charset": "cp437",
			"fill": "░",
			"title": "{product.name}  Setup",
			"credit": "Liminal Installer",
			"label": "Lieutenant Fizz — Episode One setup"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1,
					"region": "side"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Lt. Fizz",
							"role": "title"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Episode One",
							"role": "subtitle"
						}
					},
					{
						"kind": "image",
						"props": {
							"label": "Lt. Fizz",
							"alt": "Lt. Fizz",
							"art": {
								"width": 6,
								"height": 10,
								"scale": 12,
								"rects": [
									[
										1,
										0,
										4,
										1,
										"#aaaaaa"
									],
									[
										0,
										1,
										6,
										8,
										"#aa0000"
									],
									[
										0,
										4,
										6,
										2,
										"#ffffff"
									],
									[
										2,
										4,
										2,
										2,
										"#0000aa"
									],
									[
										1,
										9,
										4,
										1,
										"#aaaaaa"
									],
									[
										4,
										2,
										1,
										1,
										"#ff5555"
									]
								]
							}
						}
					},
					{
						"kind": "progress",
						"props": {
							"label": "Setup steps",
							"role": "steps",
							"value": 1,
							"max": 8,
							"text": "Step 1 of 8"
						}
					}
				]
			},
			{
				"kind": "dialog",
				"props": {
					"title": "Welcome",
					"label": "Welcome",
					"border": "double",
					"shadow": true,
					"width": 56
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 1
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Welcome to the Lieutenant Fizz setup.",
									"role": "body"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Help Lieutenant Fizz save the colony, one sector at a time. This setup installs the game, the sound drivers and the levels.",
									"role": "body"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Version {product.version} · {target.id}",
									"role": "caption"
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 2,
							"align": "centre",
							"region": "footer"
						},
						"children": [
							{
								"kind": "button",
								"props": {
									"label": "Next",
									"action": "next",
									"default": true,
									"hotkey": "N"
								}
							},
							{
								"kind": "button",
								"props": {
									"label": "Cancel",
									"action": "cancel"
								}
							}
						]
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 3,
					"region": "hints"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Continue",
							"key": "Enter"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Help",
							"key": "F1"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Quit setup",
							"key": "Esc"
						}
					}
				]
			}
		]
	}
}
