							{
								"kind": "text",
								"props": {
									"text": "Choose what to install",
									"role": "heading"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "The game is required. Everything else is optional, and you can add or remove it later.",
									"role": "body"
								}
							}
						]
					},
					{
						"kind": "checklist",
						"bind": "components.selected",
						"props": {
							"label": "Components",
							"items": "components",
							"cards": true,
							"control": "toggle"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Space required: {install.size} · Available: {system.free_space}",
							"role": "caption"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end",
					"region": "footer"
