{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "licence",
	"root": {
		"kind": "backdrop",
		"props": {
			"style": "classic",
			"title": "Lieutenant Fizz",
			"subtitle": "Episode One",
			"credit": "Setup powered by Liminal Installer",
			"taskbar": "{product.name} Setup",
			"label": "Lieutenant Fizz — Episode One setup"
		},
		"children": [
			{
				"kind": "dialog",
				"props": {
					"title": "Software License Agreement",
					"label": "Software License Agreement",
					"style": "win32-classic",
					"width": 64
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 0,
							"region": "side"
						},
						"children": [
							{
								"kind": "image",
								"props": {
									"label": "Lieutenant Fizz",
									"alt": "Lieutenant Fizz",
									"art": {
										"width": 10,
										"height": 20,
										"scale": 8,
										"rects": [
											[
												2,
												0,
												6,
												3,
												"#ff5555"
											],
											[
												1,
												2,
												8,
												1,
												"#ff5555"
											],
											[
												3,
												3,
												4,
												3,
												"#ffaa55"
											],
											[
												2,
												6,
												6,
												6,
												"#5555ff"
											],
											[
												8,
												7,
												2,
												2,
												"#aaaaaa"
											],
											[
												3,
												12,
												2,
												5,
												"#555555"
											],
											[
												6,
												12,
												2,
												5,
												"#555555"
											],
											[
												2,
												17,
												3,
												2,
												"#ff5555"
											],
											[
												6,
												17,
												3,
												2,
												"#ff5555"
											],
											[
												2,
												19,
												3,
												1,
												"#ffffff"
											],
											[
												6,
												19,
												3,
												1,
												"#ffffff"
											]
										]
									},
									"panel": "#008080",
									"ground": "#004040"
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 1
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Please read the following license agreement. Press the PAGE DOWN key to see the rest of the agreement.",
									"role": "body"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "",
									"role": "document",
									"source": "LICENCE.TXT",
									"scroll": true,
									"label": "Licence text"
								}
							},
							{
								"kind": "radio",
								"bind": "licence.accepted",
								"props": {
									"label": "Licence acceptance",
									"options": [
										{
											"id": "yes",
											"label": "I accept the agreement"
										},
										{
											"id": "no",
											"label": "I do not accept the agreement"
										}
									]
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 1,
							"align": "end",
							"region": "footer"
						},
						"children": [
							{
								"kind": "button",
								"props": {
									"label": "Back",
									"action": "back",
									"hotkey": "B"
								}
							},
							{
								"kind": "button",
								"props": {
									"label": "Next",
									"action": "next",
									"default": true,
									"hotkey": "N",
									"enabled_when": "state.licence.accepted == 'yes'"
								}
							},
							{
								"kind": "button",
								"props": {
									"label": "Cancel",
									"action": "cancel"
								}
							}
						]
					}
				]
			}
		]
	}
}
