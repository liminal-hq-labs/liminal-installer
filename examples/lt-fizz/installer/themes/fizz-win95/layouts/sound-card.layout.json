{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "sound-card",
	"root": {
		"kind": "dialog",
		"props": {
			"title": "Sound Card",
			"label": "Sound Card",
			"style": "win32-classic",
			"width": 64
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 0,
					"region": "side"
				},
				"children": [
					{
						"kind": "image",
						"props": {
							"label": "Lieutenant Fizz",
							"alt": "Lieutenant Fizz",
							"art": {
								"width": 10,
								"height": 20,
								"scale": 8,
								"rects": [
									[
										2,
										0,
										6,
										3,
										"#ff5555"
									],
									[
										1,
										2,
										8,
										1,
										"#ff5555"
									],
									[
										3,
										3,
										4,
										3,
										"#ffaa55"
									],
									[
										2,
										6,
										6,
										6,
										"#5555ff"
									],
									[
										8,
										7,
										2,
										2,
										"#aaaaaa"
									],
									[
										3,
										12,
										2,
										5,
										"#555555"
									],
									[
										6,
										12,
										2,
										5,
										"#555555"
									],
									[
										2,
										17,
										3,
										2,
										"#ff5555"
									],
									[
										6,
										17,
										3,
										2,
										"#ff5555"
									],
									[
										2,
										19,
										3,
										1,
										"#ffffff"
									],
									[
										6,
										19,
										3,
										1,
										"#ffffff"
									]
								]
							},
							"panel": "#008080",
							"ground": "#004040"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Setup found: {sound.detected}.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Choose how Lt. Fizz should play sound.",
							"role": "body"
						}
					},
					{
						"kind": "radio",
						"bind": "sound.card",
						"props": {
							"label": "Sound card",
							"options": [
								{
									"id": "none",
									"label": "No sound"
								},
								{
									"id": "speaker",
									"label": "PC speaker"
								},
								{
									"id": "adlib",
									"label": "AdLib music card"
								},
								{
									"id": "sbpro",
									"label": "Sound Blaster / Pro / 16"
								},
								{
									"id": "gus",
									"label": "Gravis UltraSound"
								}
							],
							"sunken": true
						}
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 3,
							"group": "fields"
						},
						"children": [
							{
								"kind": "field",
								"bind": "sound.port",
								"props": {
									"label": "Port",
									"default": "220",
									"width": 4
								}
							},
							{
								"kind": "field",
								"bind": "sound.irq",
								"props": {
									"label": "IRQ",
									"default": "5",
									"width": 2
								}
							},
							{
								"kind": "field",
								"bind": "sound.dma",
								"props": {
									"label": "DMA",
									"default": "1",
									"width": 2
								}
							}
						]
					},
					{
						"kind": "text",
						"props": {
							"text": "{validate.problems}",
							"role": "error",
							"label": "Problems"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 1,
					"align": "end",
					"region": "footer"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Back",
							"action": "back",
							"hotkey": "B"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true,
							"hotkey": "N"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
