{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "update-offer",
	"root": {
		"kind": "window",
		"props": {
			"title": "Neutral Sample Setup",
			"label": "Update available",
			"style": "neutral"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 12
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "An update is available",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Version {feed.latest} is ready. You have {receipt.installed}.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"role": "document",
							"text": "{feed.notes}",
							"label": "Release notes",
							"scroll": true
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 8,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Update now",
							"action": "next",
							"default": true
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Not now",
							"action": "skip"
						}
					}
				]
			}
		],
		"overrides": {
			"tui": {
				"kind": "window",
				"props": {
					"title": "Neutral Sample — Update available",
					"label": "Update available",
					"border": "rounded"
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 1
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "An update is available",
									"role": "heading"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Version {feed.latest} is ready. You have {receipt.installed}.",
									"role": "body"
								}
							},
							{
								"kind": "text",
								"props": {
									"role": "document",
									"text": "{feed.notes}",
									"label": "Release notes",
									"scroll": true
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 8,
							"align": "end"
						},
						"children": [
							{
								"kind": "button",
								"props": {
									"label": "Update now",
									"action": "next",
									"default": true
								}
							},
							{
								"kind": "button",
								"props": {
									"label": "Not now",
									"action": "skip"
								}
							}
						]
					}
				]
			}
		}
	}
}
