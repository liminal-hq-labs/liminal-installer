{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Plume Notes",
	"version": "0.4.2",
	"identifier": "ca.liminalhq.plumenotes",
	"mainBinaryName": "plume-notes",
	"build": {
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "deb", "app"],
		"publisher": "Liminal HQ",
		"homepage": "https://example.org/plume",
		"shortDescription": "Quick notes that sync when you are back online",
		"createUpdaterArtifacts": true,
		"resources": ["assets/*", "licences/NOTICE.txt"],
		"externalBin": ["binaries/plume-sync"],
		"fileAssociations": [
			{
				"ext": ["plume"],
				"name": "Plume note",
				"description": "Plume note",
				"mimeType": "application/x-plume"
			}
		],
		"windows": {
			"webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
			"allowDowngrades": true,
			"nsis": { "installMode": "both", "languages": ["English"] }
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBS0VGQUtFRkFLRQo=",
			"endpoints": ["https://example.org/plume/latest.json"],
			"windows": { "installMode": "passive" }
		},
		"deep-link": {
			"desktop": { "schemes": ["plume"] }
		}
	}
}
