{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "licence",
	"root": {
		"kind": "window",
		"props": {
			"title": "{product.name} Setup",
			"label": "Licence",
			"style": "afterglow",
			"icon": {
				"viewBox": [
					20,
					20
				],
				"shapes": [
					{
						"rect": [
							1.5,
							3,
							17,
							14
						],
						"rx": 3,
						"stroke": "#e0e0e0",
						"width": 1.5
					},
					{
						"path": "M1.5 7h17",
						"stroke": "#e0e0e0",
						"width": 1.5
					},
					{
						"rect": [
							5,
							9.5,
							5,
							5
						],
						"rx": 1,
						"fill": "#ffaa40"
					},
					{
						"path": "M11.5 10h4M11.5 13h3",
						"stroke": "#a78bfa",
						"width": 1.5,
						"cap": "round"
					}
				]
			},
			"caption": "Theme: Afterglow · the same flow runs on Windows, Linux, macOS and FreeBSD"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 0,
					"label": "Setup steps",
					"region": "side"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Welcome",
							"role": "step-item",
							"state": "done"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Licence",
							"role": "step-item",
							"state": "current"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Location",
							"role": "step-item",
							"state": "todo"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Components",
							"role": "step-item",
							"state": "todo"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Install",
							"role": "step-item",
							"state": "todo"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Done",
							"role": "step-item",
							"state": "todo"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 0,
							"group": "lead"
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Licence agreement",
									"role": "heading"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Please read and accept the licence to continue.",
									"role": "body"
								}
							}
						]
					},
					{
						"kind": "text",
						"props": {
							"text": "",
							"role": "document",
							"source": "LICENCE.TXT",
							"scroll": true,
							"label": "Licence text"
						}
					},
					{
						"kind": "radio",
						"bind": "licence.accepted",
						"props": {
							"label": "Licence acceptance",
							"options": [
								{
									"id": "yes",
									"label": "I accept the agreement"
								},
								{
									"id": "no",
									"label": "I do not accept the agreement"
								}
							]
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end",
					"region": "footer"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "You can read this again from the installed app",
							"role": "note"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Back",
							"action": "back"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true,
							"enabled_when": "state.licence.accepted == 'yes'"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
