{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "done",
	"root": {
		"kind": "window",
		"props": {
			"title": "{product.name} Setup",
			"label": "Done",
			"style": "afterglow",
			"icon": {
				"viewBox": [
					20,
					20
				],
				"shapes": [
					{
						"rect": [
							1.5,
							3,
							17,
							14
						],
						"rx": 3,
						"stroke": "#e0e0e0",
						"width": 1.5
					},
					{
						"path": "M1.5 7h17",
						"stroke": "#e0e0e0",
						"width": 1.5
					},
					{
						"rect": [
							5,
							9.5,
							5,
							5
						],
						"rx": 1,
						"fill": "#ffaa40"
					},
					{
						"path": "M11.5 10h4M11.5 13h3",
						"stroke": "#a78bfa",
						"width": 1.5,
						"cap": "round"
					}
				]
			},
			"caption": "Theme: Afterglow · the same flow runs on Windows, Linux, macOS and FreeBSD"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 0,
					"label": "Setup steps",
					"region": "side"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Welcome",
							"role": "step-item",
							"state": "done"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Licence",
							"role": "step-item",
							"state": "done"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Location",
							"role": "step-item",
							"state": "done"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Components",
							"role": "step-item",
							"state": "done"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Install",
							"role": "step-item",
							"state": "done"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Done",
							"role": "step-item",
							"state": "current"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 0,
							"group": "lead"
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "{product.name} is ready",
									"role": "heading"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Setup is complete. Thank you for installing it.",
									"role": "body"
								}
							}
						]
					},
					{
						"kind": "checklist",
						"bind": "finish.launch",
						"props": {
							"label": "After setup",
							"items": [
								{
									"id": "launch",
									"label": "Start {product.name}"
								}
							]
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end",
					"region": "footer"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "{product.name} {product.version} is installed.",
							"role": "note"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Finish",
							"action": "finish",
							"default": true
						}
					}
				]
			}
		]
	}
}
