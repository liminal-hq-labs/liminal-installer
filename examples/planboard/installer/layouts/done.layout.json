{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "done",
	"root": {
		"kind": "window",
		"props": {
			"title": "Planboard Setup",
			"label": "Setup complete",
			"style": "afterglow"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 12
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Setup is complete",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Planboard is installed. Thank you for installing it.",
							"role": "body"
						}
					},
					{
						"kind": "checklist",
						"bind": "finish.launch",
						"props": {
							"label": "After setup",
							"options": [
								{
									"id": "launch",
									"label": "Start Planboard"
								}
							]
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 8,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Finish",
							"action": "finish",
							"default": true
						}
					}
				]
			}
		],
		"overrides": {
			"tui": {
				"kind": "window",
				"props": {
					"title": "Planboard — Setup complete",
					"label": "Setup complete",
					"border": "rounded"
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 1
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Setup is complete",
									"role": "heading"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Planboard is installed. Thank you for installing it.",
									"role": "body"
								}
							},
							{
								"kind": "checklist",
								"bind": "finish.launch",
								"props": {
									"label": "After setup",
									"options": [
										{
											"id": "launch",
											"label": "Start Planboard"
										}
									]
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 8,
							"align": "end"
						},
						"children": [
							{
								"kind": "button",
								"props": {
									"label": "Finish",
									"action": "finish",
									"default": true
								}
							}
						]
					}
				]
			}
		}
	}
}
