{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "copying",
	"root": {
		"kind": "window",
		"props": {
			"title": "Planboard Setup",
			"label": "Installing",
			"style": "afterglow"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 12
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Installing {product.name}",
							"role": "heading"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Copying {progress.file}",
							"role": "body"
						}
					},
					{
						"kind": "billboard",
						"props": {
							"label": "Product highlights",
							"slides": [
								"billboard-1",
								"billboard-2"
							],
							"interval_seconds": 6
						}
					},
					{
						"kind": "meter",
						"bind": "engine.meter.file",
						"props": {
							"label": "Current file",
							"source": "file",
							"caption": "{progress.file}"
						}
					},
					{
						"kind": "meter",
						"bind": "engine.meter.total",
						"props": {
							"label": "Overall progress",
							"source": "total",
							"caption": "{progress.percent}%"
						}
					},
					{
						"kind": "meter",
						"bind": "engine.meter.free_space",
						"props": {
							"label": "Free space after install",
							"source": "free_space",
							"warn_label": "Low",
							"warn_below_percent": 5,
							"caption": "{system.free_space_after}"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 8,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		],
		"overrides": {
			"tui": {
				"kind": "window",
				"props": {
					"title": "Planboard — Installing",
					"label": "Installing",
					"border": "rounded"
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 1
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Installing {product.name}",
									"role": "heading"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Copying {progress.file}",
									"role": "body"
								}
							},
							{
								"kind": "billboard",
								"props": {
									"label": "Product highlights",
									"slides": [
										"billboard-1",
										"billboard-2"
									],
									"interval_seconds": 6
								}
							},
							{
								"kind": "meter",
								"bind": "engine.meter.file",
								"props": {
									"label": "Current file",
									"source": "file",
									"caption": "{progress.file}"
								}
							},
							{
								"kind": "meter",
								"bind": "engine.meter.total",
								"props": {
									"label": "Overall progress",
									"source": "total",
									"caption": "{progress.percent}%"
								}
							},
							{
								"kind": "meter",
								"bind": "engine.meter.free_space",
								"props": {
									"label": "Free space after install",
									"source": "free_space",
									"warn_label": "Low",
									"warn_below_percent": 5,
									"caption": "{system.free_space_after}"
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 8,
							"align": "end"
						},
						"children": [
							{
								"kind": "button",
								"props": {
									"label": "Cancel",
									"action": "cancel"
								}
							}
						]
					}
				]
			}
		}
	}
}
