{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "components",
	"root": {
		"kind": "window",
		"props": {
			"title": "Planboard Setup",
			"label": "Choose components",
			"style": "afterglow"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 12
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Choose what to install",
							"role": "heading"
						}
					},
					{
						"kind": "checklist",
						"bind": "components.selected",
						"props": {
							"label": "Components",
							"items": "components"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Space required: {install.size}",
							"role": "caption"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 8,
					"align": "end"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Back",
							"action": "back"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		],
		"overrides": {
			"tui": {
				"kind": "window",
				"props": {
					"title": "Planboard — Choose components",
					"label": "Choose components",
					"border": "rounded"
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 1
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Choose what to install",
									"role": "heading"
								}
							},
							{
								"kind": "checklist",
								"bind": "components.selected",
								"props": {
									"label": "Components",
									"items": "components"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Space required: {install.size}",
									"role": "caption"
								}
							}
						]
					},
					{
						"kind": "stack",
						"props": {
							"direction": "row",
							"gap": 8,
							"align": "end"
						},
						"children": [
							{
								"kind": "button",
								"props": {
									"label": "Back",
									"action": "back"
								}
							},
							{
								"kind": "button",
								"props": {
									"label": "Next",
									"action": "next",
									"default": true
								}
							},
							{
								"kind": "button",
								"props": {
									"label": "Cancel",
									"action": "cancel"
								}
							}
						]
					}
				]
			}
		}
	}
}
